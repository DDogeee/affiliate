DATABASE_URL=postgresql://affiliate:affiliate@postgres:5432/affiliate
STORAGE_BASE=./storage
LOG_LEVEL=info
WORKER_URL=http://worker:3001
FB_PAGE_TOKEN=""
FB_PAGE_ID=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_ACCESS_TOKEN=""
SHOPEE_AFFILIATE_KEY=""
SHOPEE_AFFILIATE_SECRET=""
TTS_KEY=""
TTS_PROVIDER="edge"
# ASR: Groq Whisper (GROQ_API_KEY) with local faster-whisper fallback
GROQ_API_KEY=""
GROQ_MODEL="whisper-large-v3"
# Hardcoded-subtitle OCR: RapidOCR local (default) | qwen (needs DASHSCOPE_API_KEY) | tesseract (chi_sim)
DASHSCOPE_API_KEY=""
QWEN_OCR_MODEL="qwen-vl-ocr"
OCR_ENGINE="" # auto: rapid | qwen | tesseract
# zh->vi translation: google gtx (free, no key) default; offline MT opt-in needs @huggingface/transformers
TRANSLATE_PROVIDER="google"
MT_MODEL="Helsinki-NLP/opus-mt-zh-vi"
