FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3 python3-pip curl fonts-noto-cjk fonts-dejavu-core tesseract-ocr tesseract-ocr-chi-sim && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages yt-dlp edge-tts faster-whisper rapidocr-onnxruntime
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci || npm install
COPY . .
ENV DATABASE_URL=postgresql://affiliate:affiliate@postgres:5432/affiliate
RUN npx prisma generate
EXPOSE 3001
ENV STORAGE_BASE=/app/storage
ENV WORKER_PORT=3001
ENV NEXT_TELEMETRY_DISABLED=1
ENV WHISPER_MODEL=base
ENV WHISPER_CACHE=/app/storage/tmp/whisper
# worker reuses the shared TS pipeline modules via tsx (tsconfig paths resolved); faster-whisper does real ASR
CMD ["npx", "tsx", "src/workers/run.ts"]
HEALTHCHECK --interval=15s --timeout=5s --retries=3 CMD node -e "fetch('http://localhost:3001/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" || exit 1