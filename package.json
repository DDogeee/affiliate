{
  "name": "weibo-affiliate-pipeline",
  "version": "0.1.0",
  "description": "Pluggable Weibo→Vietnamese affiliate video pipeline",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:contract": "vitest run --grep contract",
    "test:e2e": "vitest run --grep e2e",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "bullmq": "^5.20.0",
    "ioredis": "^5.4.1",
    "express": "^4.21.1",
    "pg": "^8.13.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "axios": "^1.7.9",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/fluent-ffmpeg": "^2.1.24"
  }
}
